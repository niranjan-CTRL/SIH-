# Copy to .env and fill in for your environment. Never commit the real .env.

# SQLite by default (fine for a prototype). For production, point this at a
# managed Postgres instance, e.g. from Render/Supabase:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./h2s_sentinel.db

# Secret used to sign auth tokens - set a long random value in production.
JWT_SECRET=change-me-to-a-long-random-string

# Exact deployed frontend origin, e.g. https://h2s-sentinel.vercel.app
# Used for CORS. Use * only for local development.
FRONTEND_URL=*

# H2S alert thresholds in ppm (spec section 12) - tune per the applicable
# occupational safety standard for the deployment site.
H2S_WARNING_PPM=10
H2S_DANGER_PPM=20
H2S_EMERGENCY_PPM=50

# Default cartridge shelf life in days - PLACEHOLDER until validated by
# real shelf-life testing (spec section 25).
CARTRIDGE_SHELF_LIFE_DAYS=30

# Where uploaded cartridge photos are stored on disk.
UPLOAD_DIR=./uploads
